# Supabase — copiar a .env.local y completar con los valores del proyecto
# (Settings → API). Usar la publishable key (nuevo formato sb_publishable_...).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Alternativa (formato clásico) si tu proyecto todavía usa la anon key JWT:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

