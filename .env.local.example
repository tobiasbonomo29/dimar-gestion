# Supabase — copiar a .env.local y completar con los valores del proyecto
# (Settings → API). Usar la publishable key (nuevo formato sb_publishable_...).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Alternativa (formato clásico) si tu proyecto todavía usa la anon key JWT:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Datos de la empresa para el membrete de las cotizaciones (PDF)
NEXT_PUBLIC_EMPRESA_NOMBRE=Dimar SRL
NEXT_PUBLIC_EMPRESA_CUIT=30-00000000-0
NEXT_PUBLIC_EMPRESA_DIRECCION=Dirección de la empresa
NEXT_PUBLIC_EMPRESA_EMAIL=ventas@dimar.com.ar
NEXT_PUBLIC_EMPRESA_TELEFONO=+54 9 11 0000-0000
